<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fill in the placeholders with the sed command in the README, then load with launchctl. -->
<plist version="1.0"><dict>
  <key>Label</key><string>io.github.hari-k-dev.telegram-afk</string>
  <key>ProgramArguments</key><array><string>__BUN__</string><string>__REPO__/daemon.ts</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <!-- 077: the log and anything else the daemon creates is owner-only. -->
  <key>Umask</key><integer>63</integer>
  <key>StandardErrorPath</key><string>__HOME__/.config/claude-tg/tgd.log</string>
  <key>StandardOutPath</key><string>__HOME__/.config/claude-tg/tgd.log</string>
</dict></plist>
